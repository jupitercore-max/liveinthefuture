# Managed by Jarvis. Deny-all by default, allowlist only user-authored text artifacts.

# Deny everything by default
*

# Allowlisted tracked surface
!/.gitignore
!/*.md
!/workspace/
!/workspace/**
!/memory/
!/memory/**

# Explicit runtime/host ignores
.env
.env.local
user/auth/
bin/
target/
sentinel/
models/
ipc/
backups/
events/
channels/
.ssh/
.ssh-host-keys/
.cache/
.local/
.config/
.gnupg/
.bash_history
.bash_logout
.bashrc
.profile
.sudo_as_admin_successful
.wget-hsts
lost+found/
.lost+found/
__pycache__/
*.sock
*.log

# SQLite databases and journals
*.db
*.db-wal
*.db-shm
*.db.*
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.*

