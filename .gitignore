# LITF site gitignore
# NOTE: This is for the liveinthefuture.org website repo, NOT the Hatch home dir.
# Do NOT replace with the Jarvis deny-all template.

# Hatch workspace/memory overlays (MUST NOT be deployed)
workspace/
memory/

# Hatch system files
AGENTS.md
SOUL.md
USER.md
IDENTITY.md
HEARTBEAT.md
TOOLS.md
CLAUDE.md
SPACES.md
ACTIVITY_LOG.md
SUBAGENTS_MONITORING.md
MEMORY.md
VEHICLE-SAFETY.md

# Build/cache artifacts
.fars_cache/
node_modules/
__pycache__/
*.pyc

# Environment
.env
.env.local
images/imagine-*
drafts/imagine-*
.workspace-hidden/
